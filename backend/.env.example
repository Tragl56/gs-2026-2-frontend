# Copie para .env e preencha. O arquivo .env NUNCA deve ser versionado.

# gemini = IA real | mock = classificador de demonstração (sem chave)
LLM_PROVIDER=gemini
GEMINI_API_KEY=coloque-sua-chave-aqui
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=25

# Origens autorizadas (separadas por vírgula). Nunca use *.
CORS_ORIGINS=http://localhost:8501

# Código de acesso da equipe da prefeitura (troque!)
MANAGER_TOKEN=troque-este-token

# Máximo de análises por IP por minuto (protege a cota do LLM)
ANALYZE_RATE_LIMIT_PER_MINUTE=10

DATABASE_PATH=data/zela.db
SEED_DEMO_DATA=true
# Janela (em dias) para contar relatos parecidos ainda abertos
SIMILAR_WINDOW_DAYS=30
